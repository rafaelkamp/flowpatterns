# Configuração do PostgreSQL utilizado pelo profile "postgres".
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# NUNCA versione o arquivo .env com credenciais reais.

DB_URL=jdbc:postgresql://localhost:5432/flowpatterns
DB_USER=flowpatterns
DB_PASSWORD=troque-esta-senha

# Ativa a carga de dados de demonstração (recomendado apenas em desenvolvimento)
SEED_ENABLED=false

# Fuso horário e porta da aplicação
SERVER_PORT=8080
TZ=America/Sao_Paulo
